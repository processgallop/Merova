# ─────────────────────────────────────────────────────────────────────
# Merova Printpack — environment variables (see docs/CONFIGURATION.md)
# Copy to .env.local for local development. Never commit real values.
# Business details (contacts, WhatsApp, analytics IDs) are managed in
# /admin → Settings, not here.
# ─────────────────────────────────────────────────────────────────────

# PostgreSQL. Required in production. Without it, local dev uses an
# embedded database in .data/pglite; Vercel runs a non-persistent demo.
DATABASE_URL=
# DATABASE_POOL_MAX=5

# Initial Super Administrator (created only when no users exist)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Public site URL (canonical URLs, sitemap, emails)
NEXT_PUBLIC_SITE_URL=https://merova-printpack.vercel.app

# Enquiry notifications (optional; enquiries are always stored in the database)
RESEND_API_KEY=
LEAD_EMAIL_FROM=                 # e.g. "Merova Printpack <enquiries@your-domain>"
LEAD_EMAIL_DEFAULT=              # fallback recipient
CRM_WEBHOOK_URL=
CRM_WEBHOOK_SECRET=

# Spam protection (optional)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# MIRA AI mode (optional; guided mode works without a key)
ANTHROPIC_API_KEY=
# MIRA_MODEL=claude-opus-5-5

# Limits (optional)
# ENQUIRY_RATE_LIMIT=6
# LOGIN_RATE_LIMIT=10

# Demo only — accept enquiries on the non-persistent in-memory database
# ALLOW_DEMO_ENQUIRIES=1
