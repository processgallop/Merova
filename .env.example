# ─────────────────────────────────────────────────────────────────────
# Merova Printpack — environment variables
# Copy to .env.local for local development. On Vercel, add these under
# Project → Settings → Environment Variables. Never commit real values.
# See docs/CONFIGURATION.md for setup steps and verification.
# ─────────────────────────────────────────────────────────────────────

# Public site URL (canonical URLs, sitemap, Open Graph, QR codes in PDFs)
NEXT_PUBLIC_SITE_URL=https://merova.vercel.app

# ── Business contact details (supplied and verified by Merova) ──────
# Leave blank until verified: the site hides these and routes visitors
# to the enquiry forms instead of showing placeholder details.
NEXT_PUBLIC_WHATSAPP_NUMBER=        # digits with country code, e.g. 9198XXXXXXXX
NEXT_PUBLIC_CONTACT_PHONE=          # display format, e.g. +91 98XXX XXXXX
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_SALES_EMAIL=
NEXT_PUBLIC_CAREERS_EMAIL=
NEXT_PUBLIC_OFFICE_ADDRESS=
NEXT_PUBLIC_PLANT_ADDRESS=
NEXT_PUBLIC_BUSINESS_HOURS=         # e.g. Mon–Sat, 9:30–18:30 IST
NEXT_PUBLIC_LEGAL_NAME=             # registered company name
NEXT_PUBLIC_GSTIN=
NEXT_PUBLIC_LINKEDIN_URL=
NEXT_PUBLIC_INSTAGRAM_URL=

# ── Enquiry delivery (at least ONE channel is required for forms) ───
# Without any channel the API returns 503 and the form says so; it
# never shows a fake success message.

# Option A: email via Resend (https://resend.com) — team notification + customer acknowledgement
RESEND_API_KEY=
LEAD_EMAIL_FROM=                    # e.g. "Merova Printpack <enquiries@your-domain>" (verified domain)
LEAD_EMAIL_DEFAULT=                 # fallback/sales inbox (required for email delivery)
# Optional team routing (falls back to LEAD_EMAIL_DEFAULT)
LEAD_EMAIL_CORRUGATED=
LEAD_EMAIL_PAPER=
LEAD_EMAIL_FOODSERVICE=
LEAD_EMAIL_FLEXIBLE=
LEAD_EMAIL_CUSTOM=
LEAD_EMAIL_TECHNICAL=
LEAD_EMAIL_ORDERS=
LEAD_EMAIL_SUPPLIERS=
LEAD_EMAIL_CAREERS=
LEAD_EMAIL_PARTNERSHIPS=

# Option B: CRM webhook — JSON lead posted to your CRM / Zapier / Make / n8n endpoint
CRM_WEBHOOK_URL=
CRM_WEBHOOK_SECRET=                 # optional; sent as X-Merova-Signature (HMAC-SHA256 of body)

# Option C (development/testing only): write leads to disk
# LEAD_STORE_DIR=.data/leads

# Optional: per-IP enquiry submissions per minute (default 6)
# ENQUIRY_RATE_LIMIT=6

# ── Spam protection (optional, recommended) — Cloudflare Turnstile ──
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ── Mira AI assistant (optional) ────────────────────────────────────
# Without a key Mira runs in guided mode over the same approved catalogue.
ANTHROPIC_API_KEY=
# MIRA_MODEL=claude-opus-5-5

# ── Analytics (optional; loaded only after cookie consent) ──────────
NEXT_PUBLIC_GA_ID=                  # G-XXXXXXXXXX
NEXT_PUBLIC_GTM_ID=                 # GTM-XXXXXXX
NEXT_PUBLIC_GSC_VERIFICATION=       # Google Search Console HTML-tag token
