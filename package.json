{
  "name": "merova-printpack",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint src tests",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate && node scripts/embed-migrations.mjs",
    "db:embed": "node scripts/embed-migrations.mjs",
    "db:check": "tsx scripts/db-check.mts",
    "db:backup": "node scripts/db-backup.mjs",
    "test:build": "NEXT_DIST_DIR=.next-qa next build",
    "test:e2e": "playwright test --trace off",
    "brand:lockup": "node scripts/brand-lockup.mjs",
    "stock:fetch": "node scripts/fetch-stock.mjs",
    "logos": "node scripts/brand-logos.mjs",
    "brand-assets": "node scripts/brand-assets.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.13.0",
    "@electric-sql/pglite": "^0.6.0",
    "drizzle-orm": "^0.45.4",
    "lucide-react": "^1.79.0",
    "next": "16.4.6",
    "postgres": "^4.1.1",
    "qrcode": "^1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.7",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^20",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
